import {
  StyleSheet,
  Text,
  View,
  TouchableOpacity,
  Platform,
  ActivityIndicator,
} from "react-native";
import {
  useState,
  useEffect,
} from "react";
import Animated, {
  FadeIn,
  ZoomInDown,
} from "react-native-reanimated";
import { SIZES } from "../constants";
import {
  MaterialIcons,
  Ionicons,
  Feather,
  MaterialCommunityIcons,
} from "@expo/vector-icons";
import {
  useUserContext,
} from "../contexts/UserContext";
import useUploadStory from "../hooks/useUploadStory";
import useResizePictures from "../hooks/useResizePictures";
import { Image } from "expo-image";
import MessageModal from "../components/shared/modals/MessageModal";
import {
  useSafeAreaInsets,
} from "react-native-safe-area-context";

const NewStory = ({
  navigation,
  route,
}) => {
  const insets =
    useSafeAreaInsets();

  const {
    selectedImage,
  } = route?.params || {};

  const {
    uploadStory,
    isLoading,
  } = useUploadStory();

  const {
    resizeStoryPicture,
  } = useResizePictures();

  const {
    currentUser,
  } = useUserContext();

  const [
    opacity,
    setOpacity,
  ] = useState(0);

  const [
    messageModalVisible,
    setMessageModalVisible,
  ] = useState(false);

  const [
    errorMessage,
    setErrorMessage,
  ] = useState("");

  useEffect(() => {
    const timer =
      setTimeout(() => {
        setOpacity(1);
      }, 250);

    return () =>
      clearTimeout(timer);
  }, []);

  const publishStory = async () => {
    if (
      isLoading ||
      !selectedImage?.uri ||
      !currentUser?.email
    ) {
      return;
    }

    try {
      const resized =
        await resizeStoryPicture(
          selectedImage.uri
        );

      if (!resized?.uri) {
        throw new Error(
          "Image processing failed."
        );
      }

      const success =
        await uploadStory(
          resized.uri,
          currentUser
        );

      if (!success) {
        throw new Error(
          "Cloudinary upload failed."
        );
      }

      navigation.replace(
        "Main Screen"
      );
    } catch (error) {
      console.error(
        "Story publish error:",
        error
      );

      setErrorMessage(
        error?.message ||
          "Story could not be published."
      );

      setMessageModalVisible(
        true
      );
    }
  };

  return (
    <View
      style={[
        styles.container,
        { opacity },
      ]}
    >
      <View
        style={styles.imageContainer}
      >
        <Animated.View
          style={
            styles.topButtonsContainer
          }
          entering={ZoomInDown.duration(
            450
          )}
        >
          <TouchableOpacity
            onPress={() =>
              navigation.goBack()
            }
            disabled={isLoading}
            style={
              styles.backButton
            }
          >
            <MaterialIcons
              name="arrow-back-ios"
              size={21}
              color="#fff"
              style={
                styles.backIcon
              }
            />
          </TouchableOpacity>

          <View
            style={
              styles.modButtons
            }
          >
            <TouchableOpacity
              style={
                styles.modButton
              }
            >
              <Feather
                name="volume-2"
                size={22}
                color="#fff"
              />
            </TouchableOpacity>

            <TouchableOpacity
              style={
                styles.modButton
              }
            >
              <Text
                style={
                  styles.aa
                }
              >
                Aa
              </Text>
            </TouchableOpacity>

            <TouchableOpacity
              style={
                styles.modButton
              }
            >
              <MaterialCommunityIcons
                name="sticker-emoji"
                size={22}
                color="#fff"
              />
            </TouchableOpacity>

            <TouchableOpacity
              style={
                styles.modButton
              }
            >
              <MaterialCommunityIcons
                name="dots-horizontal"
                size={22}
                color="#fff"
              />
            </TouchableOpacity>
          </View>
        </Animated.View>

        <Image
          source={{
            uri:
              selectedImage?.uri ||
              "",
          }}
          style={styles.image}
          contentFit="contain"
        />
      </View>

      <Animated.View
        style={
          styles.bottomButtons
        }
        entering={FadeIn.duration(
          450
        )}
      >
        <TouchableOpacity
          onPress={publishStory}
          disabled={isLoading}
          style={[
            styles.audienceButton,
            isLoading &&
              styles.disabled,
          ]}
        >
          <Image
            source={{
              uri:
                currentUser?.profile_picture ||
                "",
            }}
            style={styles.avatar}
          />

          <Text style={styles.buttonText}>
            Your story
          </Text>
        </TouchableOpacity>

        <TouchableOpacity
          onPress={publishStory}
          disabled={isLoading}
          style={[
            styles.audienceButton,
            isLoading &&
              styles.disabled,
          ]}
        >
          <View
            style={
              styles.starCircle
            }
          >
            <MaterialIcons
              name="stars"
              size={18}
              color="#3b3"
            />
          </View>

          <Text style={styles.buttonText}>
            Close Friends
          </Text>
        </TouchableOpacity>

        <TouchableOpacity
          onPress={publishStory}
          disabled={
            isLoading ||
            !selectedImage?.uri
          }
          style={[
            styles.nextButton,
            isLoading &&
              styles.disabled,
          ]}
        >
          {isLoading ? (
            <ActivityIndicator
              color="#000"
            />
          ) : (
            <Ionicons
              name="arrow-forward"
              size={24}
              color="#000"
            />
          )}
        </TouchableOpacity>
      </Animated.View>

      <MessageModal
        messageModalVisible={
          messageModalVisible
        }
        setMessageModalVisible={
          setMessageModalVisible
        }
        message={
          errorMessage ||
          "Story could not be published."
        }
        height={80}
      />

      <View
        style={{
          height: insets.bottom,
        }}
      />
    </View>
  );
};

export default NewStory;

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: "#000",
    paddingTop:
      Platform.OS === "ios"
        ? 42
        : 38,
  },

  imageContainer: {
    flex: 1,
    justifyContent: "center",
  },

  topButtonsContainer: {
    position: "absolute",
    zIndex: 5,
    top: 8,
    left: 10,
    right: 10,
    flexDirection: "row",
    justifyContent:
      "space-between",
    alignItems: "center",
  },

  backButton: {
    width: 40,
    height: 40,
    borderRadius: 20,
    justifyContent: "center",
    alignItems: "center",
    backgroundColor:
      "rgba(55,55,55,0.82)",
  },

  backIcon: {
    paddingLeft: 6,
  },

  modButtons: {
    flexDirection: "row",
    gap: 5,
  },

  modButton: {
    height: 38,
    width: 38,
    borderRadius: 19,
    justifyContent: "center",
    alignItems: "center",
    backgroundColor:
      "rgba(55,55,55,0.82)",
  },

  aa: {
    color: "#fff",
    fontWeight: "700",
    fontSize: 16,
    marginBottom: 5,
  },

  image: {
    width: SIZES.Width,
    height: "100%",
  },

  bottomButtons: {
    minHeight: 58,
    paddingHorizontal: 10,
    flexDirection: "row",
    alignItems: "center",
    gap: 6,
  },

  audienceButton: {
    flex: 1,
    height: 40,
    borderRadius: 22,
    backgroundColor: "#333",
    flexDirection: "row",
    alignItems: "center",
    justifyContent:
      "center",
    gap: 7,
  },

  avatar: {
    width: 23,
    height: 23,
    borderRadius: 12,
  },

  starCircle: {
    width: 23,
    height: 23,
    borderRadius: 12,
    backgroundColor: "#fff",
    justifyContent: "center",
    alignItems: "center",
  },

  buttonText: {
    color: "#fff",
    fontSize: 11,
    fontWeight: "700",
  },

  nextButton: {
    width: 40,
    height: 40,
    borderRadius: 20,
    backgroundColor: "#fff",
    justifyContent: "center",
    alignItems: "center",
  },

  disabled: {
    opacity: 0.55,
  },
});
